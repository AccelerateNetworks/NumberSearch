@model NumberSearch.Mvc.CartResult

@{
    ViewData["Title"] = "Internet";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function handleSearchQuery(textBox) {
        const route = 'https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/suggest?text=';
        const suffix = '&maxSuggestions=5&countryCode=USA&f=pjson';
        fetch(`${route}${encodeURIComponent(textBox.value)}${suffix}`)
            .then(response => response.json())
            .then(data => {
                if (data.suggestions == undefined) {
                    return;
                }
                const datalist = document.getElementById("addressOptions");
                datalist.innerHTML = data.suggestions
                    .map(s => `<li class='list-group-item' onclick='setAddress(this.textContent)'>${escapeHtml(s.text)}</li>`)
                    .join('');
                datalist.hidden = false;
            })
            .catch(err => console.log('Fetch Error :-S', err));
    }

    function showMessage(html) {
        document.getElementById("resultstablebody").innerHTML = `<tr><td colspan="4">${html}</td></tr>`;
        document.getElementById("spinner").hidden = true;
    }

    function setAddress(address) {
        document.getElementById("address").value = address;
        document.getElementById("addressOptions").hidden = true;
        document.getElementById("resultstablebody").innerHTML = '';
        document.getElementById("spinner").hidden = false;

        const contact = `<a href="/Support">contact us</a>`;
        const geocode = `https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/findAddressCandidates?SingleLine=${encodeURIComponent(address)}&outFields=AddNum,StName,Postal&maxLocations=1&countryCode=USA&f=pjson`;
        fetch(geocode)
            .then(response => response.json())
            .then(data => {
                if (data.candidates == undefined || data.candidates.length == 0) {
                    showMessage(`We couldn't find that address. Please pick one of the suggestions or ${contact}.`);
                    return;
                }
                const candidate = data.candidates[0];
                const params = new URLSearchParams({
                    houseNumber: candidate.attributes.AddNum ?? '',
                    street: candidate.attributes.StName ?? '',
                    postal: candidate.attributes.Postal ?? '',
                    latitude: candidate.location.y,
                    longitude: candidate.location.x
                });
                return fetch(`/Internet/Availability?${params}`)
                    .then(response => response.json())
                    .then(availability => {
                        if (!availability.serviceable) {
                            showMessage(`We don't have internet service listed at this address yet. Please ${contact} and we'll check for you.`);
                            return;
                        }
                        const qualified = `buildingKey=${encodeURIComponent(availability.buildingKey)}`;
                        const rows = availability.offers.map(offer => {
                            const price = offer.price > 0 ? `$${offer.price}/mo` : 'Quote';
                            const action = offer.status == 'Sellable'
                                ? `<button onclick="AddToCart('Service', '${offer.serviceId}', 1, this, '${qualified}')" class="btn btn-outline-primary"> <span class="d-none spinner-border spinner-border-sm mr-2" role="status">&nbsp;</span> Add to Cart </button>`
                                : `<a href="/Support" class="btn btn-outline-secondary">${offer.status == 'Quote' ? 'Request a Quote' : 'Contact Us'}</a>`;
                            return `<tr><td>${escapeHtml(offer.name)}<br /><small class="text-muted">${escapeHtml(offer.note)}</small></td><td>${escapeHtml(offer.speed)}</td><td>${price}</td><td>${action}</td></tr>`;
                        });
                        // Say which listed building we checked, since a near match might not be the address that was typed.
                        const matched = escapeHtml(availability.matchedAddress);
                        const checked = availability.matchType == 'Exact'
                            ? `Showing services for ${matched}.`
                            : availability.matchType == 'HouseNumber'
                                ? `We found ${matched} on your street, which may be a different unit or lot. Please ${contact} to confirm before ordering.`
                                : `We couldn't find this exact address, the closest listed building is ${matched}. Please ${contact} to confirm before ordering.`;
                        rows.unshift(`<tr><td colspan="4"><small class="text-muted">${checked}</small></td></tr>`);
                        document.getElementById("resultstablebody").innerHTML = rows.join('');
                        document.getElementById("spinner").hidden = true;
                    });
            })
            .catch(err => {
                console.log('Fetch Error :-S', err);
                showMessage(`Something went wrong looking up this address. Please try again or ${contact}.`);
            });
    }
</script>

<!-- Pricing Hero-->
<section class="text-light" style="background-color: #3279B2">
    <div class="container py-5 py-md-6 py-lg-7 mb-7 text-center">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-md-11">
                <h1 class="display-3 text-light d-none d-sm-block">The best internet</h1>
                <h4 class="display-4 text-light d-block d-sm-none">The best internet</h4>
                <p class="lead text-white">Symmetrical fiber internet for your business across Washington, Oregon, Idaho, and Montana.</p>
            </div>
        </div>
    </div>
</section>
<div class="bg-light pt-3 pb-3">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <p>🪨 Your internet connection is the bedrock of your business.</p>
                <p>🆕 Let us accelerate your business with symmetrical fiber internet at 300 Mbps for $75/mo or 1 Gbps for $115/mo on a 2, 3 or 5 year term.</p>
                <p>📞 Save $15/mo on fiber internet when you bundle it with any of our phone services.</p>
                <p>🏢 Need dedicated bandwidth with an SLA? Ethernet internet access is available at many business addresses, contact us for a quote.</p>
                <p>🤝 Whatever technology you choose, rest assured that Accelerate Networks will handle all the details with our Seattle-based support and installation teams.</p>
            </div>
            <div class="col-md-6">
                <h1 class="display-4">
                    Accelerate Your Business</h2>
                    <ul style="list-style: none; padding: 0px;">
                        <li>🌾 Fiber Internet 300 Mbps - $75/mo</li>
                        <li>🚀 Fiber Internet 1 Gbps - $115/mo</li>
                        <li>📞 $15/mo off when bundled with phone service</li>
                        <li>🏢 Ethernet Internet Access - quoted</li>
                    </ul>
            </div>
        </div>
    </div>
</div>
<div class="pt-3">
    <div class="container pb-3">
        @if (!string.IsNullOrWhiteSpace(Model?.Message))
        {
            <div class="pb-3 pt-3">
                <div class="container">
                    <div class="row">
                        @if (string.IsNullOrWhiteSpace(Model?.AlertType))
                        {
                            <div class="alert alert-danger col-12" role="alert">
                                @Model?.Message
                            </div>
                        }
                        else
                        {
                            var alertType = Model?.AlertType ?? "alert-danger";
                            <div class="alert @alertType col-12" role="alert">
                                @Model?.Message
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model?.Cart?.Order?.OrderId != Guid.Empty && Model?.Cart?.Order?.DateSubmitted > DateTime.MinValue)
        {
            <div class="mb-3" id="searchForm">
                <label for="address">Address in Washington, Oregon, Idaho, or Montana</label>
                <input asp-for="Cart.Order!.UnparsedAddress" type="text" class="form-control" id="address" readonly>
                <small class="text-muted">
                    Enter the service address or, the address of the installation location (ex. 1250 1st Ave S, Seattle, WA, 98134, USA)
                </small>
            </div>
        }
        else
        {
            <div class="mb-3" id="searchForm">
                <label for="address">Address in Washington, Oregon, Idaho, or Montana</label>
                <input asp-for="Cart.Order!.UnparsedAddress" type="text" class="form-control" id="address" placeholder="Enter your address to search for internet options" pattern=".+[,].+" oninput="handleSearchQuery(this)" onfocus="handleSearchQuery(this)" list="addressOptions" autocomplete="off" data-toggle="dropdown" required>
                <ul class="list-group" role="menu" aria-labelledby="menu1" id="addressOptions">
                </ul>
                <small class="text-muted">
                    Enter the service address or, the address of the installation location (ex. 1250 1st Ave S, Seattle, WA, 98134, USA)
                </small>
            </div>
        }

        <div class="table-responsive shadow-sm">
            <table class="table table-striped table-borderless table-hover">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Speed</th>
                        <th>Price</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="resultstablebody">
                </tbody>
            </table>
        </div>
        <div class="row" id="spinner" hidden>
            <div class="col">
                <div class="d-flex justify-content-center m-5">
                    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="mt-auto fixed-bottom bg-white pt-1 pb-1 shadow">
    <div class="container">
        <div class="row">
            <div class="col">
                <a type="button" class="btn btn-success btn-lg btn-block" asp-controller="Services" asp-action="Index">Add Services ▷</a>
            </div>
        </div>
    </div>
</div>
